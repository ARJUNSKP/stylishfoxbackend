# Server Configuration
PORT=8000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Connection (PostgreSQL - Supabase / Neon / Local PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/stylefox_db

# Authentication / JWT
JWT_SECRET=super_secret_stylefox_jwt_token_change_in_production
JWT_EXPIRES_IN=7d

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=stylefox-assets
R2_PUBLIC_URL=https://assets.stylefox.com
