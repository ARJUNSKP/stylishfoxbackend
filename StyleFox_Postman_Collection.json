              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"hoodie-black.jpg\",\n  \"contentType\": \"image/jpeg\",\n  \"folder\": \"products\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/uploads/presigned-url",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "uploads", "presigned-url"]
            }
          }
        },
        {
          "name": "Direct Upload to R2",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "folder", "value": "products", "type": "text" },
                { "key": "file", "type": "file", "src": [] }
